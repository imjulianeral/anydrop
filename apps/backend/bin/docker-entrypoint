#!/bin/sh
set -eu

cd /app

if [ "$#" -eq 0 ]; then
  set -- /app/bin/anyshare start
fi

if [ -n "${DATABASE_URL:-}" ]; then
  attempt=1
  max_attempts=30

  while [ "${attempt}" -le "${max_attempts}" ]; do
    if /app/bin/anyshare eval "Anyshare.Release.migrate()"; then
      break
    fi

    if [ "${attempt}" -eq "${max_attempts}" ]; then
      echo "database migrate failed after ${max_attempts} attempts" >&2
      exit 1
    fi

    echo "database migrate failed (attempt ${attempt}/${max_attempts}); retrying" >&2
    attempt=$((attempt + 1))
    sleep 2
  done
fi

exec "$@"
