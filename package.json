{
  "name": "phemera",
  "version": "0.0.1",
  "workspaces": [
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "start": "nub index.ts",
    "dev": "alchemy dev",
    "check": "ultracite check --ignore-pattern=vendors/**",
    "fix": "ultracite fix --ignore-pattern=vendors/**",
    "shadscan": "npx -y @shadscan/cli@0.17.0 apps/web",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "plan": "alchemy plan"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@effect/platform-bun": "4.0.0-rc.115",
    "@effect/platform-node": "4.0.0-rc.115",
    "alchemy": "2.0.0-beta.78",
    "effect": "4.0.0-rc.115"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260814.1",
    "@nubjs/types": "0.9.0",
    "@shadcn/lint": "^0.2.0",
    "@types/node": "^24",
    "oxfmt": "latest",
    "oxlint": "latest",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7",
    "ultracite": "7.12.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.9.0",
      "onFail": "ignore"
    }
  }
}
